{
  "name": "skimcp",
  "version": "0.1.0",
  "description": "MCP server / CLI tool",
  "main": "./dist/index.js",
  "bin": {
    "skimcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run harvest && npm run build -w frontend && npm run build -w backend && cp -r backend/dist ./dist && chmod +x ./dist/index.js ./dist/cli.js",
    "harvest": "tsx scripts/harvest-directory.ts",
    "start": "npm run start -w backend",
    "test": "npm run test -w backend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "deploy:vercel": "vercel",
    "docker:build": "docker build -t skimcp .",
    "docker:run": "docker run --rm -p 8080:8080 skimcp"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
